{
  "name": "energy-game",
  "version": "1.0.0",
  "description": "an energy game",
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "sprites:forest": "node --experimental-strip-types scripts/generate-forest-sprites.ts",
    "sprites:reservoir": "node --experimental-strip-types scripts/generate-reservoir-sprites.ts",
    "atlas": "node --experimental-strip-types scripts/pack-atlas.ts",
    "atlas:check": "node --experimental-strip-types scripts/pack-atlas.ts --check",
    "icons:check": "node --experimental-strip-types scripts/check-icon-coverage.ts --check",
    "lint": "eslint .",
    "clean": "rm -r -fo dist -ErrorAction SilentlyContinue",
    "clean:web": "rm -r -fo dist/web -ErrorAction SilentlyContinue",
    "dev:client": "vite",
    "copy:assets": "cp static dist/web -r -Force",
    "build:client": "tsc -p tsconfig.json && vite build && pnpm run copy:assets",
    "open:client": "vite preview --open",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "electron": "tsc -p electron/tsconfig.json && electron dist/electron/main.js",
    "electron:rebuild": "electron-rebuild -f -w ."
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  },
  "private": true,
  "dependencies": {
    "electron": "^43.1.1"
  }
}
